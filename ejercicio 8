#include <iostream>
#include <cmath>
using namespace std;

void resolverCuadratica(double a, double b, double c) {
    if (a == 0 && b == 0 && c == 0) {
        cout << "Infinitas soluciones." << endl;
    } else if (a == 0 && b == 0) {
        cout << "Sin solucion." << endl;
    } else if (a == 0) {
        cout << "Ecuacion lineal. Solucion: x = " << (-c / b) << endl;
    } else {
        double disc = b * b - 4 * a * c;
        if (disc > 0) {
            double x1 = (-b + sqrt(disc)) / (2 * a);
            double x2 = (-b - sqrt(disc)) / (2 * a);
            cout << "Dos raices reales: x1 = " << x1 << ", x2 = " << x2 << endl;
        } else if (disc == 0) {
            double x = -b / (2 * a);
            cout << "Una raiz doble real: x = " << x << endl;
        } else {
            double real = -b / (2 * a);
            double imag = sqrt(-disc) / (2 * a);
            cout << "Dos raices complejas: " << real << " + " << imag << "i y "
                 << real << " - " << imag << "i" << endl;
        }
    }
}

int main() {
    double a, b, c;
    cout << "Ingrese a, b y c: ";
    cin >> a >> b >> c;
    resolverCuadratica(a, b, c);
    return 0;
}
