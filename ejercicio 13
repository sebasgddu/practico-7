#include <iostream>
#include <cmath>
#include <iomanip>
using namespace std;

double redondear(double R, int n) {
    double factor = pow(10.0, n);
    return round(R * factor) / factor;
}

int main() {
    double R;
    int n;
    cout << "Ingrese numero real R y cantidad de decimales n: ";
    cin >> R >> n;

    cout << fixed << setprecision(n);
    cout << "Numero redondeado: " << redondear(R, n) << endl;
    return 0;
}
