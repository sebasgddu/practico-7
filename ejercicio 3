#include <iostream>
using namespace std;

double potenciaEntera(double x, int exp) {
    double r = 1;
    for (int i = 1; i <= exp; i++) {
        r = r * x;
    }
    return r;
}

double factorial(int n) {
    double f = 1;
    for (int i = 2; i <= n; i++) {
        f = f * i;
    }
    return f;
}

double sumaSerie(int x, int N) {
    double s = 0;
    for (int i = 1; i <= N; i++) {
        s = s + potenciaEntera(x, i) / factorial(i);
    }
    return s;
}

int main() {
    int x, N;
    cout << "Ingrese X y N (enteros positivos): ";
    cin >> x >> N;
    cout << "Suma S = " << sumaSerie(x, N) << endl;
    return 0;
}
